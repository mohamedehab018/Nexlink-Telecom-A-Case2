# Copy to .env and fill in real values. Never commit .env.
# The MCP server and the RAG layer read secrets from the environment only.

# Required for the agent (and for LLM-based RAG generation / Self-RAG critic).
# Preferred provider: OpenRouter (higher limits, OpenAI-compatible). When
# OPENROUTER_API_KEY is set it takes precedence over GROQ_API_KEY.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-oss-120b

# Fallback provider: Groq free tier.
GROQ_API_KEY=

# Optional: LLM model override. The agent uses OPENROUTER_MODEL (OpenRouter)
# or GROQ_MODEL (Groq); the RAG layer uses LLM_MODEL — on OpenRouter use full
# ids like meta-llama/llama-3.3-70b-instruct.
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct

# Optional: reasoning effort for reasoning models like gpt-oss (low|medium|high).
# Lower = faster responses; the chat backend defaults to "low".
# GROQ_REASONING_EFFORT=low

# ---------------------------------------------------------------------------
# RAG embeddings
# ---------------------------------------------------------------------------
# sentence_transformers (default, semantic) | offline / ngram (no deps) | openai
# RAG_EMBEDDING_PROVIDER=sentence_transformers
# RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional: OpenAI embeddings (only if provider=openai).
# OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# RAG retrieval
# ---------------------------------------------------------------------------
# RAG_VECTOR_PATH=rag/vector_db
# RAG_COLLECTION=nextlink_knowledge
# RAG_TOP_K=4
# RAG_RRF_K=60
# RAG_MAX_ROUNDS=3
# RAG_HNSW_M=16
# RAG_HNSW_EF_CONSTRUCT=100

# ---------------------------------------------------------------------------
# Self-RAG verification gate
# ---------------------------------------------------------------------------
# RAG_USE_LLM_CRITIC=false
# RAG_RELEVANCE_THRESHOLD=0.20
# RAG_VERIFY_RELEVANCE_THRESHOLD=0.20
